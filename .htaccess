Options -Indexes
RewriteEngine On
RewriteBase /

# ========== SECURITY - PROTECT SENSITIVE FILES ==========

# Protect .env file from direct access
<Files .env>
    Order allow,deny
    Deny from all
</Files>

# Protect configuration and log files
<FilesMatch "\.(env|log|sql|md|txt|json)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ========== PERFORMANCE OPTIMIZATION ==========

# Enable Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml+rss application/rss+xml font/truetype font/opentype application/vnd.ms-fontobject image/svg+xml
</IfModule>

# Browser caching - Set cache headers for assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  
  # Cache images for 1 year (static assets rarely change)
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/x-windows-icon "access plus 1 year"
  
  # Cache CSS and JavaScript for 1 month
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  
  # Cache fonts for 1 year
  ExpiresByType font/truetype "access plus 1 year"
  ExpiresByType font/opentype "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  
  # HTML files - shorter cache (1 hour)
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Add Cache-Control headers
<IfModule mod_headers.c>
  # Cache static assets
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|css|js|woff|woff2|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Don't cache HTML/PHP pages
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ========== SECURITY & OPTIMIZATION ==========

# Increase upload and POST size limits
php_value upload_max_filesize 50M
php_value post_max_size 50M
php_value max_input_time 300
php_value max_execution_time 300

# Increase memory limit for file processing
php_value memory_limit 256M

# ========== URL REWRITING ==========

# Don't rewrite for actual files, directories, or pages folder
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_URI} ^/pages/
RewriteRule ^ - [L]

# Clean routes for top-level pages -> map to pages/* (match actual lowercase filenames)
RewriteRule ^about/?$ /pages/about.html [L]
RewriteRule ^contact/?$ /pages/contact.html [L]
RewriteRule ^program/?$ /pages/program.php [L]
RewriteRule ^workshop/?$ /pages/workshop.php [L]
RewriteRule ^blog/?$ /pages/blog.php [L]
RewriteRule ^terms/?$ /pages/terms.html [L]

# Program detail routing
RewriteRule ^program/([a-zA-Z0-9-]+)/?$ /pages/program_detail.php?slug=$1 [L,QSA]

# Redirect .html extensions to clean URLs
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+pages/terms\.html
RewriteRule ^ /terms [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+terms\.html
RewriteRule ^ /terms [R=301,L]

# Blog detail page (slug routing)
RewriteRule ^blogs/([a-zA-Z0-9-]+)/?$ /pages/blog_detail.php?slug=$1 [L,QSA]

# Internal rewrite for clean URLs (exclude .php files)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.(php|html|css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot)$ [NC]
RewriteRule ^(.+)$ $1.php [L,QSA]

# ========== SECURITY HEADERS ==========

<IfModule mod_headers.c>
  # Prevent MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"
  
  # Enable XSS protection
  Header always set X-XSS-Protection "1; mode=block"
  
  # Clickjacking prevention
  Header always set X-Frame-Options "SAMEORIGIN"
  
  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

