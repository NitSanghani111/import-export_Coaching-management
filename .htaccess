Options -Indexes
RewriteEngine On
RewriteBase /

# ========== PERFORMANCE OPTIMIZATION ==========

# Enable Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml+rss application/rss+xml font/truetype font/opentype application/vnd.ms-fontobject image/svg+xml
</IfModule>

# Browser caching - Set cache headers for assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  
  # Cache images for 30 days
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/x-windows-icon "access plus 1 month"
  
  # Cache CSS and JavaScript for 2 weeks
  ExpiresByType text/css "access plus 2 weeks"
  ExpiresByType application/javascript "access plus 2 weeks"
  ExpiresByType text/javascript "access plus 2 weeks"
  
  # Cache fonts for 1 year
  ExpiresByType font/truetype "access plus 1 year"
  ExpiresByType font/opentype "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  
  # Cache HTML for 1 hour (for dynamic content)
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Set cache control headers
<IfModule mod_headers.c>
  # Static assets - Cache for 1 month
  <FilesMatch "\.(jpg|jpeg|png|gif|ico|css|js|woff|woff2|ttf|svg|eot)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
  
  # HTML - Cache for 1 hour
  <FilesMatch "\.html$">
    Header set Cache-Control "max-age=3600, public, must-revalidate"
  </FilesMatch>
  
  # PHP files - Don't cache
  <FilesMatch "\.php$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ========== SECURITY & OPTIMIZATION ==========

# Increase upload and POST size limits
php_value upload_max_filesize 50M
php_value post_max_size 50M
php_value max_input_time 300
php_value max_execution_time 300

# Increase memory limit for file processing
php_value memory_limit 256M

# ========== URL REWRITING ==========

# Don't rewrite for actual files, directories, or pages folder
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_URI} ^/pages/
RewriteRule ^ - [L]

# Clean routes for top-level pages -> map to pages/* (match actual lowercase filenames)
RewriteRule ^about/?$ /pages/about.html [L]
RewriteRule ^contact/?$ /pages/contact.html [L]
RewriteRule ^program/?$ /pages/program.html [L]
RewriteRule ^workshop/?$ /pages/workshop.php [L]
RewriteRule ^blog/?$ /pages/blog.php [L]
RewriteRule ^trypage/?$ /pages/trypage.html [L]

# Blog detail page (slug routing)
RewriteRule ^blogs/([a-zA-Z0-9-]+)/?$ /pages/blog_detail.php?slug=$1 [L,QSA]

# Internal rewrite for clean URLs (exclude .php files)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.(php|html|css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot)$ [NC]
RewriteRule ^(.+)$ $1.php [L,QSA]

# ========== SECURITY HEADERS ==========

<IfModule mod_headers.c>
  # Prevent MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"
  
  # Enable XSS protection
  Header always set X-XSS-Protection "1; mode=block"
  
  # Clickjacking prevention
  Header always set X-Frame-Options "SAMEORIGIN"
  
  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

